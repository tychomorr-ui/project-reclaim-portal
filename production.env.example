# Project Reclaim production runtime template
# Copy to a protected local file such as /etc/project-reclaim/project-reclaim.env.
# Never commit the copied file. Recommended permissions: chmod 600.

NODE_ENV=production
PORT=3000

# Database: use a TLS-enabled least-privilege MySQL/TiDB account.
DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/DATABASE?ssl=%7B%22rejectUnauthorized%22%3Atrue%7D

# Session and OAuth configuration.
JWT_SECRET=generate-a-long-random-secret
VITE_APP_ID=replace-with-approved-oauth-app-id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im
OWNER_OPEN_ID=replace-with-owner-open-id
OWNER_NAME=Project Reclaim administrator

# Managed integration layer. Leave unset unless the deployment is authorized to use it.
BUILT_IN_FORGE_API_URL=https://forge.manus.ai
BUILT_IN_FORGE_API_KEY=replace-with-server-side-key
VITE_FRONTEND_FORGE_API_URL=https://forge.manus.ai
VITE_FRONTEND_FORGE_API_KEY=replace-with-approved-frontend-key

# Optional owner notifications. Keep unset if notifications are not enabled.
RESEND_API_KEY=replace-if-enabled
RESEND_FROM_EMAIL=Project Reclaim <no-reply@example.org>
OWNER_NOTIFICATION_EMAIL=replace-if-enabled

# Optional analytics. Do not enable until the privacy notice and consent posture are approved.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional application mode. The default is planning-only unless explicitly authorized.
PROJECT_RECLAIM_COMPOUND_UPGRADE_MODE=planning-only
